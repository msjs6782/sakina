<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes are suggestions; the launcher decides. The widget re-measures its text for the size it gets. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.sakina.app.widgets.WidgetConfigActivity"
    android:description="@string/w_desc_dhikr"
    android:initialLayout="@layout/w_dhikr"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/w_dhikr"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
