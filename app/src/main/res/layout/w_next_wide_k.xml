<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/widgets/gen_layouts.py -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_shape_16" />

    <ImageView
        android:id="@+id/w_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_scrim"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_stroke_16_1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_place"
                style="@style/WK.Text.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/w_sample_place" />

            <ImageView
                android:id="@+id/w_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/w_refresh"
                android:padding="2dp"
                android:src="@drawable/w_ic_refresh" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_name"
                style="@style/WK.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/w_sample_name" />

            <TextView
                android:id="@+id/w_time"
                style="@style/WK.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/w_sample_time" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_remain"
            style="@style/WK.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_sample_remain_stamp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_msg"
        style="@style/WK.Text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:maxLines="4"
        android:padding="12dp"
        android:textAlignment="center"
        android:visibility="gone" />
</FrameLayout>
