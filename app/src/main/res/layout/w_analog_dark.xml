<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/widgets/gen_layouts.py -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_shape_16" />

    <ImageView
        android:id="@+id/w_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_stroke_16_1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/w_dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <AnalogClock
                android:id="@+id/w_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/w_dial_blank"
                android:hand_hour="@drawable/w_hand_hour_dark"
                android:hand_minute="@drawable/w_hand_minute_dark" />
        </FrameLayout>
        <TextView
            android:id="@+id/w_name"
            style="@style/W.Text.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_sample_name_time"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:id="@+id/w_place"
            style="@style/W.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/w_sample_place"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_msg"
        style="@style/W.Text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:maxLines="4"
        android:padding="12dp"
        android:textAlignment="center"
        android:visibility="gone" />
</FrameLayout>
