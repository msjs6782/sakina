<?xml version="1.0" encoding="utf-8"?>
<!-- A smoked-glass chip under each prayer over a painting: darker than the picture so white text reads, with a lit rim above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#59000000"
                android:startColor="#33000000" />
            <stroke
                android:width="0.8dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
