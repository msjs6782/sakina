<?xml version="1.0" encoding="utf-8"?>
<!-- The next prayer's smoked-glass chip over a painting, with a gold rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#66000000"
                android:startColor="#40000000" />
            <stroke
                android:width="1dp"
                android:color="#E6E5C57E" />
        </shape>
    </item>
</layer-list>
