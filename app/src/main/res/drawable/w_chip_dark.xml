<?xml version="1.0" encoding="utf-8"?>
<!-- A frosted chip under each prayer on the dark glass panel in relief: lighter at the top, a bright rim above and a
     shade below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#0AFFFFFF"
                android:startColor="#29FFFFFF" />
            <stroke
                android:width="0.8dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>
</layer-list>
